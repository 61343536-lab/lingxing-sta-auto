# Copy to .env and set locally. Never commit actual credentials.
LINGXING_APP_ID=
LINGXING_APP_SECRET=
# Explicit enterprise-wide mode. Keep false unless every visible store is intended.
LINGXING_ALL_STORES=false
# Required when LINGXING_ALL_STORES=false; only these store IDs can appear in results.
LINGXING_ALLOWED_SIDS=
BUSINESS_TIMEZONE=Asia/Shanghai
# The completed tab is a status filter, independent of this date field.
PACKING_DATE_FIELD=create
LINGXING_TIMEOUT_MS=20000

# stdio for local MCP clients; http for a remote HTTPS reverse proxy.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3100
# HTTP requires an independent random bearer token of at least 32 characters.
MCP_BEARER_TOKEN=
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=
